<Window x:Class="EffModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EffModManager"
        Title="EFF Mod Manager" Icon="app.ico" Height="820" Width="1240" MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
        AllowDrop="True" DragEnter="Window_DragEnter" Drop="Window_Drop">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#25342E">
      <Grid Margin="22,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="6" Background="#FFFFFF" Padding="2" Margin="0,0,11,0">
            <Image Source="app.ico" Stretch="Uniform" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="EFF" Foreground="White" FontSize="17" FontWeight="Bold" />
            <TextBlock Text="MOD MANAGER" Foreground="#BDD0C5" FontSize="9" FontWeight="SemiBold" Margin="0,1,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#82C89B" Margin="0,0,8,0" />
          <TextBlock x:Name="HeaderStatus" Text="{Binding [footer.ready], Source={x:Static local:LanguageService.Instance}}" Foreground="#DCE7E0" FontSize="12" MaxWidth="420" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Row="1" TabStripPlacement="Left" Background="{StaticResource Canvas}" BorderThickness="0" SelectionChanged="MainTabs_SelectionChanged">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,26,10,12">
                  <TextBlock Text="{Binding [nav.workspace], Source={x:Static local:LanguageService.Instance}}" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="12,0,0,9" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20">
                  <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,13" />
                  <TextBlock Text="{Binding [game.title], Source={x:Static local:LanguageService.Instance}}" Foreground="{StaticResource Muted}" FontSize="10" />
                </StackPanel>
                <TabPanel IsItemsHost="True" Margin="0" />
              </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource Canvas}">
              <ContentPresenter ContentSource="SelectedContent" Margin="28,24,28,22" />
            </Border>
          </Grid>
        </ControlTemplate>
      </TabControl.Template>

      <TabItem>
        <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0"/><TextBlock Text="{Binding [tab.overview], Source={x:Static local:LanguageService.Instance}}" /></StackPanel></TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding [overview.title], Source={x:Static local:LanguageService.Instance}}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding [overview.subtitle], Source={x:Static local:LanguageService.Instance}}" Foreground="{StaticResource Muted}" Margin="0,4,0,23" />

            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="20" Margin="0,0,8,0">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" FontSize="16" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding [game.title], Source={x:Static local:LanguageService.Instance}}" FontSize="14" FontWeight="SemiBold" />
                  </StackPanel>
                  <TextBox x:Name="GamePathBox" Grid.Row="1" Grid.ColumnSpan="2" Height="38" Margin="0,0,0,12" TextChanged="GamePath_TextChanged" LostFocus="GamePath_LostFocus" />
                  <Button Grid.Row="2" HorizontalAlignment="Left" Click="ScanGame_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="{Binding [game.scan], Source={x:Static local:LanguageService.Instance}}" /></StackPanel></Button>
                  <Button Grid.Row="2" Grid.Column="1" Margin="8,0,0,0" Click="BrowseGame_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="{Binding [game.browse], Source={x:Static local:LanguageService.Instance}}" /></StackPanel></Button>
                </Grid>
              </Border>

              <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="20" Margin="8,0,0,0">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" FontSize="16" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding [dll.title], Source={x:Static local:LanguageService.Instance}}" FontSize="14" FontWeight="SemiBold" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="{StaticResource AccentLight}" CornerRadius="4" Padding="9,4">
                    <TextBlock x:Name="DllStateText" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                  <TextBlock x:Name="DllVersionText" Grid.Row="1" Grid.ColumnSpan="2" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,11,0,15" TextWrapping="Wrap" />
                  <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button x:Name="InstallDllButton" Style="{StaticResource PrimaryButton}" Click="InstallDll_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="{Binding [dll.install], Source={x:Static local:LanguageService.Instance}}" /></StackPanel></Button>
                    <Button x:Name="UninstallDllButton" Margin="8,0,0,0" Click="UninstallDll_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="{Binding [dll.remove], Source={x:Static local:LanguageService.Instance}}" /></StackPanel></Button>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>

            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="#E4F0EB" CornerRadius="5" Padding="17" Margin="0,0,6,0">
                <StackPanel><TextBlock Text="{Binding [overview.mods], Source={x:Static local:LanguageService.Instance}}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="ModCountText" Text="0" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,6,0,0"/></StackPanel>
              </Border>
              <Border Grid.Column="1" Background="#F8E9E4" CornerRadius="5" Padding="17" Margin="6,0">
                <StackPanel><TextBlock Text="{Binding [overview.enabled], Source={x:Static local:LanguageService.Instance}}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="EnabledCountText" Text="0" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Coral}" Margin="0,6,0,0"/></StackPanel>
              </Border>
              <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="17" Margin="6,0,0,0">
                <StackPanel><TextBlock Text="{Binding [overview.latestDll], Source={x:Static local:LanguageService.Instance}}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="LatestDllText" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,9,0,0"/></StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0"/><TextBlock Text="{Binding [tab.mods], Source={x:Static local:LanguageService.Instance}}" /></StackPanel></TabItem.Header>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Click="ImportMod_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="{Binding [mods.import], Source={x:Static local:LanguageService.Instance}}" /></StackPanel></Button>
              <Button Margin="8,0,0,0" Click="DeleteMod_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="{Binding [mods.delete], Source={x:Static local:LanguageService.Instance}}" /></StackPanel></Button>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="{Binding [mods.title], Source={x:Static local:LanguageService.Instance}}" FontSize="23" FontWeight="SemiBold" />
              <TextBlock Text="{Binding [mods.subtitle], Source={x:Static local:LanguageService.Instance}}" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
            </StackPanel>
          </DockPanel>

          <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="ModSearchBox" Height="36" MaxWidth="430" HorizontalAlignment="Left" TextChanged="ModSearch_TextChanged" ToolTip="{Binding [mods.search], Source={x:Static local:LanguageService.Instance}}" />
            <Border Grid.Column="1" Background="#E7EFEB" CornerRadius="4" Padding="10,6" VerticalAlignment="Center">
              <TextBlock x:Name="ModListCount" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" />
            </Border>
          </Grid>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Grid.ColumnSpan="2" AllowDrop="True" DragEnter="Mods_DragEnter" Drop="Window_Drop" Background="#EAF2ED" BorderBrush="#A8C5B3" BorderThickness="1" CornerRadius="5" Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" FontSize="17" Margin="0,0,10,0" />
                <TextBlock Text="{Binding [mods.drop], Source={x:Static local:LanguageService.Instance}}" FontWeight="SemiBold" />
                <TextBlock Text="  ·  " Foreground="{StaticResource Muted}" />
                <TextBlock Text="{Binding [mods.dropSub], Source={x:Static local:LanguageService.Instance}}" Foreground="{StaticResource Muted}" FontSize="12" />
              </StackPanel>
            </Border>
            <DataGrid x:Name="ModsList" Grid.Row="1" Grid.Column="0" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="ModsList_SelectionChanged" Margin="0,0,8,0">
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="58"><DataGridTemplateColumn.Header><TextBlock Text="{Binding [mods.state], Source={x:Static local:LanguageService.Instance}}" /></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}" Click="ModEnabled_Click" HorizontalAlignment="Center" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Width="*" Binding="{Binding Name}" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{Binding [mods.name], Source={x:Static local:LanguageService.Instance}}" /></DataGridTextColumn.Header></DataGridTextColumn>
                <DataGridTextColumn Width="125" Binding="{Binding Author}" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{Binding [mods.author], Source={x:Static local:LanguageService.Instance}}" /></DataGridTextColumn.Header></DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyModsOverlay" Grid.Row="1" Grid.Column="0" Text="{Binding [mods.empty], Source={x:Static local:LanguageService.Instance}}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
            <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="19" Margin="8,0,0,0">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="{Binding [mods.details], Source={x:Static local:LanguageService.Instance}}" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" />
                  <TextBlock x:Name="DetailsName" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,3" TextWrapping="Wrap" />
                  <TextBlock x:Name="DetailsMeta" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                  <Border Height="1" Background="{StaticResource Line}" Margin="0,15,0,13" />
                  <TextBlock Text="{Binding [mods.description], Source={x:Static local:LanguageService.Instance}}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                  <TextBlock x:Name="DetailsDescription" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding [mods.keys], Source={x:Static local:LanguageService.Instance}}" FontSize="12" FontWeight="SemiBold" Margin="0,15,0,5" />
                  <ItemsControl x:Name="DetailsKeys" />
                  <TextBlock x:Name="DetailsPath" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,16,0,0" />
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem>
        <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0"/><TextBlock Text="{Binding [tab.repair], Source={x:Static local:LanguageService.Instance}}" /></StackPanel></TabItem.Header>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,17">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <TextBlock x:Name="RepairCountText" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
              <Button Click="SelectAllRepair_Click" Content="{Binding [repair.selectAll], Source={x:Static local:LanguageService.Instance}}" />
              <Button x:Name="RepairButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OpenRepair_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="{Binding [repair.run], Source={x:Static local:LanguageService.Instance}}" /></StackPanel></Button>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="{Binding [repair.title], Source={x:Static local:LanguageService.Instance}}" FontSize="23" FontWeight="SemiBold" />
              <TextBlock Text="{Binding [repair.subtitle], Source={x:Static local:LanguageService.Instance}}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="14,11" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding [repair.resource], Source={x:Static local:LanguageService.Instance}}" FontSize="11" Foreground="{StaticResource Muted}" />
                <TextBox x:Name="ResourceRootBox" Height="34" Margin="0,5,0,0" LostFocus="ResourceRoot_LostFocus" />
              </StackPanel>
              <Button Grid.Column="1" VerticalAlignment="Bottom" Margin="9,0,0,0" Click="BrowseResources_Click" Content="{Binding [repair.browse], Source={x:Static local:LanguageService.Instance}}" />
            </Grid>
          </Border>
          <DataGrid x:Name="RepairModsList" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" SelectionUnit="FullRow" Margin="0,0,0,12">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Width="64" Binding="{Binding IsRepairSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"><DataGridCheckBoxColumn.Header><TextBlock Text="{Binding [repair.select], Source={x:Static local:LanguageService.Instance}}" /></DataGridCheckBoxColumn.Header></DataGridCheckBoxColumn>
              <DataGridTextColumn Width="*" Binding="{Binding Name}" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{Binding [mods.name], Source={x:Static local:LanguageService.Instance}}" /></DataGridTextColumn.Header></DataGridTextColumn>
              <DataGridTextColumn Width="180" Binding="{Binding Author}" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{Binding [mods.author], Source={x:Static local:LanguageService.Instance}}" /></DataGridTextColumn.Header></DataGridTextColumn>
              <DataGridTextColumn Width="130" Binding="{Binding Version}" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{Binding [mods.version], Source={x:Static local:LanguageService.Instance}}" /></DataGridTextColumn.Header></DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="RepairEmptyText" Grid.Row="2" Text="{Binding [mods.empty], Source={x:Static local:LanguageService.Instance}}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
          <StackPanel Grid.Row="3">
            <ProgressBar x:Name="RepairProgressBar" Height="3" IsIndeterminate="False" Visibility="Collapsed" Foreground="{StaticResource Accent}" />
            <TextBlock x:Name="RepairStatusText" Text="{Binding [repair.status], Source={x:Static local:LanguageService.Instance}}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0" />
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem>
        <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0"/><TextBlock Text="{Binding [tab.settings], Source={x:Static local:LanguageService.Instance}}" /></StackPanel></TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{Binding [settings.title], Source={x:Static local:LanguageService.Instance}}" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,21" />
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="19" Margin="0,0,0,13">
              <StackPanel>
                <TextBlock Text="{Binding [settings.language], Source={x:Static local:LanguageService.Instance}}" FontWeight="SemiBold" FontSize="14" />
                <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                  <RadioButton x:Name="ChineseRadio" Content="中文" GroupName="Language" IsChecked="True" Checked="Language_Checked" Margin="0,0,22,0" />
                  <RadioButton x:Name="EnglishRadio" Content="English" GroupName="Language" Checked="Language_Checked" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="19" Margin="0,0,0,13">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding [settings.updates], Source={x:Static local:LanguageService.Instance}}" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Text="{Binding [settings.updatePolicy], Source={x:Static local:LanguageService.Instance}}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0" />
                  <TextBlock x:Name="ManagerVersionText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Click="CheckUpdates_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="{Binding [settings.checkUpdates], Source={x:Static local:LanguageService.Instance}}" /></StackPanel></Button>
              </Grid>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="19">
              <StackPanel>
                <TextBlock Text="{Binding [settings.resources], Source={x:Static local:LanguageService.Instance}}" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="{Binding [settings.resourceHint], Source={x:Static local:LanguageService.Instance}}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,12" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Margin="9,0,0,0" Click="BrowseResources_Click" Content="{Binding [repair.browse], Source={x:Static local:LanguageService.Instance}}" />
                  <TextBox x:Name="SettingsResourceRootBox" Height="36" LostFocus="ResourceRoot_LostFocus" TextChanged="SettingsResourceRoot_TextChanged" />
                </DockPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <Grid Margin="20,0"><TextBlock x:Name="FooterStatus" Text="{Binding [footer.ready], Source={x:Static local:LanguageService.Instance}}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/><TextBlock x:Name="FooterGame" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" MaxWidth="700" /></Grid>
    </Border>
  </Grid>
</Window>
