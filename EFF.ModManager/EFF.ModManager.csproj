<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <DefineConstants>$(DefineConstants);EFF_SOURCE_READER</DefineConstants>
    <AssemblyName>EFF.ModManager</AssemblyName>
    <RootNamespace>EffModManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <NativeCompilerPath>$(MSBuildThisFileDirectory)RepairCore\eff_resource_pack.exe</NativeCompilerPath>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
    <Content Include="$(NativeCompilerPath)" Link="native\eff_resource_pack.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\THIRD_PARTY_NOTICES" Link="THIRD_PARTY_NOTICES" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
